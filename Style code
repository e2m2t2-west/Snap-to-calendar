style.css
:root {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #17231f;
  background: #f5f7f5;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 7%;
  background: white;
  border-bottom: 1px solid #e5ebe7;
}

.brand {
  color: #176b4b;
  font-size: 20px;
  font-weight: 800;
  text-decoration: none;
}

.tagline {
  color: #65736b;
  font-size: 14px;
}

.container {
  width: min(960px, 90%);
  margin: 55px auto;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 32px;
  align-items: start;
}

.hero, .event-card {
  background: white;
  padding: 30px;
  border: 1px solid #e4ebe6;
  border-radius: 20px;
  box-shadow: 0 8px 28px #183a2710;
}

.eyebrow {
  color: #16845b;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

h1 {
  font-size: clamp(36px, 5vw, 54px);
  line-height: 1.08;
  letter-spacing: -2px;
  margin: 18px 0;
}

.intro, .event-card p {
  color: #66736b;
  line-height: 1.7;
}

.upload-box {
  margin-top: 26px;
  padding: 28px 16px;
  border: 2px dashed #b6d5c3;
  border-radius: 14px;
  background: #f7fbf8;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 9px;
  cursor: pointer;
  text-align: center;
}

.upload-icon {
  font-size: 32px;
  color: #16845b;
}

.upload-box span:last-of-type {
  color: #748178;
  font-size: 13px;
}

#image-input {
  max-width: 100%;
  font-size: 13px;
}

#preview {
  display: block;
  max-width: 100%;
  max-height: 250px;
  margin: 16px auto;
  border-radius: 12px;
}

[hidden] {
  display: none !important;
}

.primary-button {
  width: 100%;
  margin-top: 18px;
  padding: 14px;
  background: #176b4b;
  color: white;
  border: none;
  border-radius: 10px;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.primary-button:hover {
  background: #105239;
}

#status {
  font-size: 14px;
  overflow-wrap: anywhere;
}

.event-card h2 {
  margin-top: 0;
}

.event-card label {
  display: block;
  margin-top: 18px;
  margin-bottom: 7px;
  font-size: 14px;
  font-weight: 650;
}

.event-card input {
  width: 100%;
  padding: 12px;
  border: 1px solid #d6e0d9;
  border-radius: 9px;
  font: inherit;
}

footer {
  padding: 25px;
  text-align: center;
  color: #77837b;
  font-size: 13px;
}

@media (max-width: 700px) {
  .container {
    grid-template-columns: 1fr;
    margin: 25px auto;
  }

  .topbar {
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero, .event-card {
    padding: 22px;
  }
}
