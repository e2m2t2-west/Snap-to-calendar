<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Turn screenshots into calendar events with Snap to Calendar.">
  <title>Snap to Calendar</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="#">Snap to Calendar</a>
    <span class="tagline">Your events, simplified.</span>
  </header>

  <main class="container">
    <section class="hero">
      <p class="eyebrow">LESS TYPING. MORE DOING.</p>
      <h1>Your screenshot.<br> Your calendar.</h1>
      <p class="intro">
        Upload a screenshot of an event and start turning
        its details into a calendar entry.
      </p>

      <form id="upload-form">
        <label class="upload-box" for="image-input">
          <span class="upload-icon">＋</span>
          <strong>Choose an event screenshot</strong>
          <span>PNG, JPG, or WEBP</span>
          <input
            id="image-input"
            type="file"
            accept="image/png,image/jpeg,image/webp"
            required
          >
        </label>
        <img id="preview" alt="Selected screenshot preview" hidden>
        <button type="submit" class="primary-button">
          Scan screenshot
        </button>
      </form>

      <p id="status" role="status" aria-live="polite">
        Your event details will appear here.
      </p>
    </section>

    <section class="event-card">
      <h2>Event details</h2>
      <p>Review your event information before adding it.</p>

      <form id="event-form">
        <label for="event-title">Event name</label>
        <input id="event-title" placeholder="e.g. Soccer practice" required>

        <label for="event-date">Date</label>
        <input id="event-date" type="date" required>

        <label for="event-time">Start time</label>
        <input id="event-time" type="time" required>

        <label for="event-location">Location</label>
        <input id="event-location" placeholder="Enter a place or address">

        <button type="submit" class="primary-button">
          Add to calendar
        </button>
      </form>
    </section>
  </main>

  <footer>
    Snap to Calendar · Make every screenshot count.
  </footer>

  <script src="script.js"></script>
</body>
</html>
